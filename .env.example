# Choose one provider. OpenAI is the default when AI_PROVIDER is omitted.
AI_PROVIDER=openai
DOCUMENT_LANGUAGE=EN
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-terra

# To use Bedrock, replace the settings above with the following and install requirements.txt.
# AI_PROVIDER=bedrock
# DOCUMENT_LANGUAGE=IL
# AWS_PROFILE=my-profile
# AWS_REGION=eu-west-1
# Choose one EU vision model, ordered roughly cheapest -> most expensive:
# BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
# BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0
# BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-5-20251101-v1:0
# BEDROCK_MAX_TOKENS=8192
